{
  "openapi": "3.0.0",
  "info": {
    "title": "Запись на звонок",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/api/admin/bookings": {
      "get": {
        "operationId": "AdminBookings_list",
        "description": "Предстоящие Записи всех Типов встречи одним списком.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/meeting-types": {
      "post": {
        "operationId": "AdminMeetingTypes_create",
        "description": "Создать Тип встречи.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingType"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingTypeInput"
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "operationId": "Bookings_create",
        "description": "Записаться на свободный слот.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SlotTakenError"
                    },
                    {
                      "$ref": "#/components/schemas/NotFoundError"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingInput"
              }
            }
          }
        }
      }
    },
    "/api/meeting-types": {
      "get": {
        "operationId": "MeetingTypes_list",
        "description": "Список Типов встречи.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeetingType"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/meeting-types/{id}/slots": {
      "get": {
        "operationId": "MeetingTypes_slots",
        "description": "Свободные слоты Типа встречи в окне записи.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "explode": false
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotList"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "meetingTypeId",
          "startsAt",
          "endsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "meetingTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          }
        },
        "description": "Запись гостя на конкретное время."
      },
      "BookingInput": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "startsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          }
        },
        "description": "Данные для создания Записи."
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Заготовка разговора, которую заводит владелец."
      },
      "MeetingTypeInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Данные для создания Типа встречи."
      },
      "NotFoundError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_found"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "description": "Ресурс не найден."
      },
      "Slot": {
        "type": "object",
        "required": [
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Отрезок рабочего времени, на который можно записаться."
      },
      "SlotList": {
        "type": "object",
        "required": [
          "timezone",
          "slots"
        ],
        "properties": {
          "timezone": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        },
        "description": "Свободные слоты Типа встречи вместе с таймзоной, в которой их показывать."
      },
      "SlotTakenError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "slot_taken"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "description": "Слот заняли между показом и отправкой формы."
      }
    }
  }
}
